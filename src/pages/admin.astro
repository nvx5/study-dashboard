---
import Layout from "../layouts/Layout.astro";
import {
  DEFAULT_TAG_COLORS,
  DEFAULT_TAG_NAMES,
  TOPIC_COLUMNS_DEFAULT,
  normalizeTagColors,
} from "../lib/display";
import { CURRICULUM_FILENAME, CURRICULUM_TEXT } from "../lib/curriculum";
import { DEFAULT_TITLE } from "../lib/defaults";
import { categoryProgress } from "../lib/progress";
import { getState } from "../lib/store";
import { DATA_VERSION, type AppState } from "../lib/types";

let loaded = true;
let state: AppState;

try {
  state = await getState();
} catch {
  loaded = false;
  state = {
    version: DATA_VERSION,
    title: DEFAULT_TITLE,
    theme: "dark",
    source: CURRICULUM_TEXT,
    topicColumns: TOPIC_COLUMNS_DEFAULT,
    tagNames: { ...DEFAULT_TAG_NAMES },
    tagColors: { ...DEFAULT_TAG_COLORS },
    categories: [],
    updatedAt: 0,
  };
}

const boot = JSON.stringify({
  loaded,
  state,
}).replace(/</g, "\\u003c");

const tagColors = normalizeTagColors(state.tagColors);
---

<Layout title="Admin" page="admin">
  <div class="wrap">
    <p id="load-error" class="banner" hidden={loaded} role="status">
      Couldn’t load saved topics. You can still edit, then save when the connection returns.
    </p>

    <section class="file" aria-label="topics">
      <div class="file-head">
        <span class="file-name">topics</span>
        <div class="file-head-actions">
          <p id="save-status" class="save-status" aria-live="polite"></p>
          <span id="topics-meta" class="file-meta">
            {state.categories.length} {state.categories.length === 1 ? "category" : "categories"}
          </span>
        </div>
      </div>
      <div id="list" class="categories">
        {
          state.categories.map((category) => {
            const progress = categoryProgress(category);
            return (
              <details class="category" data-id={category.id}>
                <summary>
                  <span class="summary-name">{category.name}</span>
                  <span class="summary-progress">{progress.label}</span>
                  <button
                    type="button"
                    class="btn collapse"
                    data-action="collapse"
                    aria-pressed={category.collapsed}
                  >
                    {category.collapsed ? "Collapsed" : "Shown"}
                  </button>
                </summary>
                <ul class="topics">
                  {category.topics.map((topic) => (
                    <li class="topic" data-id={topic.id} data-confidence={topic.confidence}>
                      <span class="topic-name">{topic.name}</span>
                      <div class="segment" role="group" aria-label={`Confidence for ${topic.name}`}>
                        <button
                          type="button"
                          class="seg red"
                          data-action="confidence"
                          data-value="red"
                          aria-pressed={topic.confidence === "red"}
                        >
                          3
                        </button>
                        <button
                          type="button"
                          class="seg yellow"
                          data-action="confidence"
                          data-value="yellow"
                          aria-pressed={topic.confidence === "yellow"}
                        >
                          2
                        </button>
                        <button
                          type="button"
                          class="seg green"
                          data-action="confidence"
                          data-value="green"
                          aria-pressed={topic.confidence === "green"}
                        >
                          1
                        </button>
                      </div>
                    </li>
                  ))}
                </ul>
              </details>
            );
          })
        }
        <p id="empty" class="empty" hidden={state.categories.length > 0}>
          Save curriculum.txt to generate topic cards.
        </p>
      </div>
    </section>

    <section class="file" aria-label={CURRICULUM_FILENAME}>
      <div class="file-head">
        <span class="file-name">{CURRICULUM_FILENAME}</span>
        <div class="file-head-actions">
          <p id="curriculum-status" class="save-status" aria-live="polite"></p>
          <button type="button" class="btn" id="copy-curriculum">Copy</button>
          <button type="button" class="btn primary" id="save-curriculum">Save</button>
        </div>
      </div>
      <div class="file-body">
        <textarea
          id="source"
          class="source"
          spellcheck="false"
          wrap="soft"
          aria-label={CURRICULUM_FILENAME}
        >{state.source}</textarea>
      </div>
    </section>

    <section class="file" aria-label="layout">
      <div class="file-head">
        <span class="file-name">layout</span>
        <div class="file-head-actions">
          <p id="display-status" class="save-status" aria-live="polite"></p>
        </div>
      </div>
      <div class="display-panel">
        <div class="display-row">
          <span class="display-label">Columns</span>
          <div class="display-columns" id="topic-columns" role="group" aria-label="Topic columns">
            <button type="button" class="btn" data-columns="1" aria-pressed={state.topicColumns === 1}>1</button>
            <button type="button" class="btn" data-columns="2" aria-pressed={state.topicColumns === 2}>2</button>
            <button type="button" class="btn" data-columns="3" aria-pressed={state.topicColumns === 3}>3</button>
            <button type="button" class="btn" data-columns="4" aria-pressed={state.topicColumns === 4}>4</button>
          </div>
        </div>
        <div class="display-row display-row-tag">
          <span class="display-label">3</span>
          <input type="color" class="tag-color-input" data-tag="red" value={tagColors.red} aria-label="Colour for 3" />
          <input
            type="text"
            class="tag-hex-input"
            data-tag="red"
            value={tagColors.red}
            maxlength="7"
            spellcheck="false"
            aria-label="Hex colour for 3"
          />
        </div>
        <div class="display-row display-row-tag">
          <span class="display-label">2</span>
          <input type="color" class="tag-color-input" data-tag="yellow" value={tagColors.yellow} aria-label="Colour for 2" />
          <input
            type="text"
            class="tag-hex-input"
            data-tag="yellow"
            value={tagColors.yellow}
            maxlength="7"
            spellcheck="false"
            aria-label="Hex colour for 2"
          />
        </div>
        <div class="display-row display-row-tag">
          <span class="display-label">1</span>
          <input type="color" class="tag-color-input" data-tag="green" value={tagColors.green} aria-label="Colour for 1" />
          <input
            type="text"
            class="tag-hex-input"
            data-tag="green"
            value={tagColors.green}
            maxlength="7"
            spellcheck="false"
            aria-label="Hex colour for 1"
          />
        </div>
      </div>
    </section>
  </div>

  <script id="boot" type="application/json" is:inline set:html={boot} />

  <script is:inline>
    (function () {
      var bootEl = document.getElementById("boot");
      var listEl = document.getElementById("list");
      var emptyEl = document.getElementById("empty");
      var statusEl = document.getElementById("save-status");
      var curriculumStatusEl = document.getElementById("curriculum-status");
      var loadErrorEl = document.getElementById("load-error");
      var sourceEl = document.getElementById("source");
      var copyEl = document.getElementById("copy-curriculum");
      var saveEl = document.getElementById("save-curriculum");
      var topicsMetaEl = document.getElementById("topics-meta");
      var displayStatusEl = document.getElementById("display-status");
      var topicColumnsEl = document.getElementById("topic-columns");
      if (!bootEl || !listEl || !emptyEl || !statusEl || !sourceEl || !saveEl) return;

      var boot = JSON.parse(bootEl.textContent || "{}");
      var state = boot.state || { title: "Curriculum", theme: "dark", source: "", categories: [] };
      var inFlight = false;
      var queued = false;
      var queuedSource = false;
      var queuedDisplay = null;
      var clearTimer = 0;
      var tagTimer = 0;

      function setStatus(text, kind, targets) {
        var els = targets || [statusEl];
        for (var s = 0; s < els.length; s++) {
          if (!els[s]) continue;
          els[s].textContent = text;
          els[s].dataset.kind = kind || "";
        }
        window.clearTimeout(clearTimer);
        if (kind === "ok") {
          clearTimer = window.setTimeout(function () {
            for (var i = 0; i < els.length; i++) {
              if (els[i] && els[i].dataset.kind === "ok") {
                els[i].textContent = "";
                els[i].dataset.kind = "";
              }
            }
          }, 1600);
        }
      }

      function displayStatusTargets() {
        if (displayStatusEl) return [displayStatusEl];
        return [statusEl];
      }

      function parseHex(value) {
        var s = String(value || "").replace(/^\s+|\s+$/g, "").replace(/^#/, "");
        if (s.length === 3 && /^[0-9a-fA-F]{3}$/.test(s)) {
          s = s.charAt(0) + s.charAt(0) + s.charAt(1) + s.charAt(1) + s.charAt(2) + s.charAt(2);
        }
        if (!/^[0-9a-fA-F]{6}$/.test(s)) return "";
        return "#" + s.toLowerCase();
      }

      function collectTagColors() {
        var colors = Object.assign({}, state.tagColors || {});
        var els = document.querySelectorAll(".tag-hex-input");
        for (var i = 0; i < els.length; i++) {
          var key = els[i].getAttribute("data-tag");
          var hex = parseHex(els[i].value);
          if (key && hex) colors[key] = hex;
        }
        return colors;
      }

      function layoutRetryPatch() {
        return {
          topicColumns: Number(state.topicColumns),
          tagColors: collectTagColors(),
        };
      }

      function syncTagInputs() {
        var colors = state.tagColors || {};
        var hexEls = document.querySelectorAll(".tag-hex-input");
        for (var h = 0; h < hexEls.length; h++) {
          var hexKey = hexEls[h].getAttribute("data-tag");
          var hex = hexKey && parseHex(colors[hexKey]);
          if (hex && document.activeElement !== hexEls[h]) hexEls[h].value = hex;
        }
        var colorEls = document.querySelectorAll(".tag-color-input");
        for (var c = 0; c < colorEls.length; c++) {
          var colorKey = colorEls[c].getAttribute("data-tag");
          var color = colorKey && parseHex(colors[colorKey]);
          if (color) colorEls[c].value = color;
        }
      }

      function applyDisplay(data) {
        if (typeof data.topicColumns === "number") state.topicColumns = data.topicColumns;
        if (data.tagNames) state.tagNames = data.tagNames;
        if (data.tagColors) state.tagColors = data.tagColors;
        if (typeof data.updatedAt === "number") state.updatedAt = data.updatedAt;
        if (topicColumnsEl) {
          var colBtns = topicColumnsEl.querySelectorAll("[data-columns]");
          for (var c = 0; c < colBtns.length; c++) {
            colBtns[c].setAttribute(
              "aria-pressed",
              String(Number(colBtns[c].getAttribute("data-columns")) === Number(state.topicColumns)),
            );
          }
        }
        syncTagInputs();
      }

      function findCategory(id) {
        for (var i = 0; i < state.categories.length; i++) {
          if (state.categories[i].id === id) return state.categories[i];
        }
        return null;
      }

      function findTopic(category, id) {
        for (var i = 0; i < category.topics.length; i++) {
          if (category.topics[i].id === id) return category.topics[i];
        }
        return null;
      }

      function progressLabel(category) {
        var total = category.topics.length;
        var done = 0;
        for (var i = 0; i < total; i++) {
          if (category.topics[i].confidence === "green") done++;
        }
        var pct = total === 0 ? 0 : Math.round((done * 100) / total);
        return done + "/" + total + " (" + pct + "%)";
      }

      function openIds() {
        var ids = [];
        var open = listEl.querySelectorAll("details[open]");
        for (var i = 0; i < open.length; i++) ids.push(open[i].getAttribute("data-id"));
        return ids;
      }

      function escapeHtml(value) {
        return String(value)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      function renderList() {
        var opened = openIds();
        var html = "";
        for (var c = 0; c < state.categories.length; c++) {
          var category = state.categories[c];
          html += '<details class="category" data-id="' + escapeHtml(category.id) + '"' + (opened.indexOf(category.id) !== -1 ? " open" : "") + ">";
          html += "<summary>";
          html += '<span class="summary-name"></span>';
          html += '<span class="summary-progress">' + escapeHtml(progressLabel(category)) + "</span>";
          html += '<button type="button" class="btn collapse" data-action="collapse" aria-pressed="' + (category.collapsed ? "true" : "false") + '">';
          html += category.collapsed ? "Collapsed" : "Shown";
          html += "</button></summary><ul class='topics'>";
          for (var t = 0; t < category.topics.length; t++) {
            var topic = category.topics[t];
            html += '<li class="topic" data-id="' + escapeHtml(topic.id) + '" data-confidence="' + escapeHtml(topic.confidence) + '">';
            html += '<span class="topic-name"></span>';
            html += '<div class="segment" role="group" aria-label="Confidence">';
            html +=
              '<button type="button" class="seg red" data-action="confidence" data-value="red" aria-pressed="' +
              (topic.confidence === "red" ? "true" : "false") +
              '">3</button>';
            html +=
              '<button type="button" class="seg yellow" data-action="confidence" data-value="yellow" aria-pressed="' +
              (topic.confidence === "yellow" ? "true" : "false") +
              '">2</button>';
            html +=
              '<button type="button" class="seg green" data-action="confidence" data-value="green" aria-pressed="' +
              (topic.confidence === "green" ? "true" : "false") +
              '">1</button>';
            html += "</div></li>";
          }
          html += "</ul></details>";
        }
        if (!state.categories.length) {
          html = '<p id="empty" class="empty">Save curriculum.txt to generate topic cards.</p>';
        }
        listEl.innerHTML = html;
        emptyEl = document.getElementById("empty");
        if (topicsMetaEl) {
          var n = state.categories.length;
          topicsMetaEl.textContent = n + (n === 1 ? " category" : " categories");
        }

        var cats = listEl.querySelectorAll(".category");
        for (var i = 0; i < cats.length; i++) {
          var catNode = cats[i];
          var cat = findCategory(catNode.getAttribute("data-id"));
          if (!cat) continue;
          catNode.querySelector(".summary-name").textContent = cat.name;
          var rows = catNode.querySelectorAll(".topic");
          for (var r = 0; r < rows.length; r++) {
            var item = cat.topics[r];
            if (!item) continue;
            rows[r].querySelector(".topic-name").textContent = item.name;
          }
        }
      }

      function saveStatusTargets(includeSource, displayPatch) {
        if (includeSource && curriculumStatusEl) return [curriculumStatusEl];
        if (displayPatch && !includeSource) return displayStatusTargets();
        return [statusEl];
      }

      async function save(includeSource, displayPatch) {
        if (inFlight) {
          queued = true;
          if (includeSource) queuedSource = true;
          if (displayPatch) queuedDisplay = Object.assign({}, queuedDisplay || {}, displayPatch);
          return;
        }
        inFlight = true;
        var statusTargets = saveStatusTargets(includeSource, displayPatch);
        if (displayPatch) queuedDisplay = Object.assign({}, queuedDisplay || {}, displayPatch);
        setStatus("Saving…", "pending", statusTargets);
        try {
          do {
            var sendSource = queuedSource || includeSource;
            var sendDisplay = queuedDisplay;
            queued = false;
            queuedSource = false;
            queuedDisplay = null;
            includeSource = false;
            statusTargets = saveStatusTargets(sendSource, sendDisplay);
            var body = {
              title: state.title || "MSRA Master Clinical Curriculum",
              theme: "dark",
              categories: state.categories,
            };
            if (sendSource) body.source = sourceEl.value;
            if (sendDisplay) {
              if (typeof sendDisplay.topicColumns === "number") body.topicColumns = sendDisplay.topicColumns;
              if (sendDisplay.tagNames) body.tagNames = sendDisplay.tagNames;
              if (sendDisplay.tagColors) body.tagColors = sendDisplay.tagColors;
            }
            var res = await fetch("/api/topics", {
              method: "PUT",
              headers: { "Content-Type": "application/json", Accept: "application/json" },
              body: JSON.stringify(body),
            });
            var data = await res.json().catch(function () {
              return {};
            });
            if (!res.ok) throw new Error(data.error || "Save failed");
            if (sendSource && data.categories) {
              state = data;
              if (typeof data.source === "string") sourceEl.value = data.source;
              renderList();
            } else if (data.categories) {
              state.categories = data.categories;
              state.updatedAt = data.updatedAt || Date.now();
            } else {
              state.updatedAt = data.updatedAt || Date.now();
            }
            applyDisplay(data);
            if (loadErrorEl) loadErrorEl.hidden = true;
          } while (queued);
          setStatus("Saved", "ok", statusTargets);
        } catch (err) {
          setStatus(err && err.message ? err.message : "Couldn’t save. Tap to retry.", "error", statusTargets);
        } finally {
          inFlight = false;
        }
      }

      applyDisplay(state);

      statusEl.addEventListener("click", function () {
        if (statusEl.dataset.kind === "error") save(false);
      });
      if (curriculumStatusEl) {
        curriculumStatusEl.addEventListener("click", function () {
          if (curriculumStatusEl.dataset.kind === "error") save(true);
        });
      }

      if (copyEl) {
        copyEl.addEventListener("click", function () {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(sourceEl.value).then(
              function () {
                copyEl.textContent = "Copied";
                window.setTimeout(function () {
                  copyEl.textContent = "Copy";
                }, 1200);
              },
              function () {},
            );
          }
        });
      }

      saveEl.addEventListener("click", function () {
        save(true);
      });

      if (displayStatusEl) {
        displayStatusEl.addEventListener("click", function () {
          if (displayStatusEl.dataset.kind === "error") {
            save(false, layoutRetryPatch());
          }
        });
      }

      if (topicColumnsEl) {
        topicColumnsEl.addEventListener("click", function (event) {
          var button = event.target.closest("button[data-columns]");
          if (!button) return;
          var n = Number(button.getAttribute("data-columns"));
          applyDisplay({ topicColumns: n });
          save(false, { topicColumns: n });
        });
      }

      function bindTagInputs() {
        var colorEls = document.querySelectorAll(".tag-color-input");
        for (var c = 0; c < colorEls.length; c++) {
          colorEls[c].addEventListener("input", function (event) {
            var key = event.target.getAttribute("data-tag");
            var hex = parseHex(event.target.value);
            if (!key || !hex) return;
            var hexEl = document.querySelector('.tag-hex-input[data-tag="' + key + '"]');
            if (hexEl) hexEl.value = hex;
            window.clearTimeout(tagTimer);
            save(false, { tagColors: collectTagColors() });
          });
        }
        var hexEls = document.querySelectorAll(".tag-hex-input");
        for (var h = 0; h < hexEls.length; h++) {
          hexEls[h].addEventListener("input", function (event) {
            var key = event.target.getAttribute("data-tag");
            var hex = parseHex(event.target.value);
            if (!key || !hex) return;
            var colorEl = document.querySelector('.tag-color-input[data-tag="' + key + '"]');
            if (colorEl) colorEl.value = hex;
            window.clearTimeout(tagTimer);
            tagTimer = window.setTimeout(function () {
              save(false, { tagColors: collectTagColors() });
            }, 250);
          });
          hexEls[h].addEventListener("change", function (event) {
            var hex = parseHex(event.target.value);
            window.clearTimeout(tagTimer);
            if (!hex) {
              syncTagInputs();
              return;
            }
            save(false, { tagColors: collectTagColors() });
          });
        }
      }

      bindTagInputs();

      listEl.addEventListener("click", function (event) {
        var button = event.target.closest("button");
        if (!button) return;
        var action = button.getAttribute("data-action");
        var catNode = button.closest(".category");
        if (!catNode) return;
        var category = findCategory(catNode.getAttribute("data-id"));
        if (!category) return;

        if (action === "collapse") {
          event.preventDefault();
          event.stopPropagation();
          category.collapsed = !category.collapsed;
          button.setAttribute("aria-pressed", category.collapsed ? "true" : "false");
          button.textContent = category.collapsed ? "Collapsed" : "Shown";
          save(false);
          return;
        }

        if (action === "confidence") {
          var row = button.closest(".topic");
          if (!row) return;
          var topic = findTopic(category, row.getAttribute("data-id"));
          if (!topic) return;
          topic.confidence = button.getAttribute("data-value");
          var buttons = row.querySelectorAll("[data-action='confidence']");
          for (var i = 0; i < buttons.length; i++) {
            buttons[i].setAttribute(
              "aria-pressed",
              buttons[i].getAttribute("data-value") === topic.confidence ? "true" : "false",
            );
          }
          row.setAttribute("data-confidence", topic.confidence);
          catNode.querySelector(".summary-progress").textContent = progressLabel(category);
          save(false);
        }
      });
    })();
  </script>
</Layout>
