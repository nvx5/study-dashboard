---
import Layout from "../layouts/Layout.astro";
import { ANKI_FILENAME, MAX_ANKI_SOURCE_LENGTH } from "../lib/anki";
import {
  ANKI_CARD_MS,
  ANKI_FRONT_MS,
  ANKI_HEIGHT_DEFAULT,
  ANKI_HEIGHT_MAX,
  ANKI_HEIGHT_MIN,
} from "../lib/anki-cycle";
import { TOPIC_COLUMNS_DEFAULT } from "../lib/display";
import { CURRICULUM_FILENAME, CURRICULUM_TEXT, lineCount } from "../lib/curriculum";
import { DEFAULT_TITLE } from "../lib/defaults";
import { categoryProgress } from "../lib/progress";
import { getState } from "../lib/store";
import { DATA_VERSION, type AppState } from "../lib/types";

let loaded = true;
let state: AppState;

try {
  state = await getState();
} catch {
  loaded = false;
  state = {
    version: DATA_VERSION,
    title: DEFAULT_TITLE,
    theme: "dark",
    source: CURRICULUM_TEXT,
    ankiSource: "",
    ankiCards: [],
    ankiHidden: false,
    ankiHeightVh: ANKI_HEIGHT_DEFAULT,
    ankiCycleAt: 0,
    topicColumns: TOPIC_COLUMNS_DEFAULT,
    categories: [],
    updatedAt: 0,
  };
}

const boot = JSON.stringify({
  loaded,
  state,
  anki: {
    frontMs: ANKI_FRONT_MS,
    cardMs: ANKI_CARD_MS,
    heightMin: ANKI_HEIGHT_MIN,
    heightMax: ANKI_HEIGHT_MAX,
  },
}).replace(/</g, "\\u003c");
---

<Layout title="Admin" page="admin">
  <div class="wrap">
    <p id="load-error" class="banner" hidden={loaded} role="status">
      Couldn’t load saved topics. You can still edit, then save when the connection returns.
    </p>

    <section class="file" aria-label={CURRICULUM_FILENAME}>
      <div class="file-head">
        <span class="file-name">{CURRICULUM_FILENAME}</span>
        <span id="file-meta" class="file-meta">{lineCount(state.source)} lines</span>
        <p id="save-status" class="save-status" aria-live="polite"></p>
        <button type="button" class="btn" id="copy-curriculum">Copy</button>
        <button type="button" class="btn primary" id="save-curriculum">Save</button>
      </div>
      <div class="file-body">
        <pre id="gutter" class="gutter" aria-hidden="true"></pre>
        <textarea
          id="source"
          class="source"
          spellcheck="false"
          wrap="off"
          aria-label={CURRICULUM_FILENAME}
        >{state.source}</textarea>
      </div>
    </section>

    <section class="file" aria-label={ANKI_FILENAME}>
      <div class="file-head">
        <span class="file-name">{ANKI_FILENAME}</span>
        <span id="anki-meta" class="file-meta">{state.ankiCards.length} cards</span>
        <p id="anki-status" class="save-status" aria-live="polite"></p>
        <input
          id="anki-upload"
          class="visually-hidden"
          type="file"
          accept=".txt,text/plain"
          data-max={MAX_ANKI_SOURCE_LENGTH}
        />
        <button type="button" class="btn" id="copy-anki">Copy</button>
        <button type="button" class="btn" id="upload-anki">Upload</button>
        <button type="button" class="btn primary" id="save-anki">Save</button>
      </div>
      <div class="file-body anki-body">
        <pre id="anki-gutter" class="gutter" aria-hidden="true"></pre>
        <textarea
          id="anki-source"
          class="source"
          spellcheck="false"
          wrap="off"
          aria-label={ANKI_FILENAME}
          placeholder={"Paste an Anki Notes in Plain Text export, or Upload the .txt file.\nCloze cards ({{c1::answer}}) work. Extra text after the tab shows on the back."}
        >{state.ankiSource}</textarea>
      </div>
    </section>

    <section class="file" aria-label="Display">
      <div class="file-head">
        <span class="file-name">Display</span>
        <span id="display-meta" class="file-meta">Kiosk Anki</span>
        <p id="display-status" class="save-status" aria-live="polite"></p>
      </div>
      <div class="display-panel">
        <div class="display-row">
          <span class="display-label">Columns</span>
          <div class="display-columns" id="topic-columns" role="group" aria-label="Topic columns">
            <button type="button" class="btn" data-columns="1" aria-pressed={state.topicColumns === 1}>1</button>
            <button type="button" class="btn" data-columns="2" aria-pressed={state.topicColumns === 2}>2</button>
            <button type="button" class="btn" data-columns="3" aria-pressed={state.topicColumns === 3}>3</button>
            <button type="button" class="btn" data-columns="4" aria-pressed={state.topicColumns === 4}>4</button>
          </div>
        </div>
        <div class="display-row">
          <span class="display-label">Anki card</span>
          <button type="button" class="btn" id="anki-visible" aria-pressed={!state.ankiHidden}>
            {state.ankiHidden ? "Hidden" : "Shown"}
          </button>
        </div>
        <div class="display-row">
          <span class="display-label">Card height</span>
          <input
            id="anki-height"
            type="range"
            min={ANKI_HEIGHT_MIN}
            max={ANKI_HEIGHT_MAX}
            value={state.ankiHeightVh}
            aria-label="Anki card height"
          />
          <span id="anki-height-val" class="display-height-val">{state.ankiHeightVh}vh</span>
        </div>
        <div class="display-timer" id="anki-timer">
          <div class="display-timer-stage" id="anki-timer-stage">No cards</div>
          <div class="display-timer-clock" id="anki-timer-clock">—</div>
          <div class="display-timer-sub" id="anki-timer-sub">Upload or paste anki.txt to start the cycle</div>
        </div>
        <div class="display-actions">
          <button type="button" class="btn" id="anki-show-answer">Show answer</button>
          <button type="button" class="btn" id="anki-next-stage">Next stage</button>
          <button type="button" class="btn" id="anki-next-card">Next card</button>
        </div>
      </div>
    </section>

    <section class="file" aria-label="Topics">
      <div class="file-head">
        <span class="file-name">Topics</span>
        <span id="topics-meta" class="file-meta">
          {state.categories.length} {state.categories.length === 1 ? "category" : "categories"}
        </span>
      </div>
      <div id="list" class="categories">
        {
          state.categories.map((category) => {
            const progress = categoryProgress(category);
            return (
              <details class="category" data-id={category.id}>
                <summary>
                  <span class="summary-name">{category.name}</span>
                  <span class="summary-progress">{progress.label}</span>
                  <button
                    type="button"
                    class="btn collapse"
                    data-action="collapse"
                    aria-pressed={category.collapsed}
                  >
                    {category.collapsed ? "Collapsed" : "Shown"}
                  </button>
                </summary>
                <ul class="topics">
                  {category.topics.map((topic) => (
                    <li class="topic" data-id={topic.id} data-confidence={topic.confidence}>
                      <span class="topic-name">{topic.name}</span>
                      <div class="segment" role="group" aria-label={`Confidence for ${topic.name}`}>
                        <button
                          type="button"
                          class="seg red"
                          data-action="confidence"
                          data-value="red"
                          aria-pressed={topic.confidence === "red"}
                        >
                          Need
                        </button>
                        <button
                          type="button"
                          class="seg yellow"
                          data-action="confidence"
                          data-value="yellow"
                          aria-pressed={topic.confidence === "yellow"}
                        >
                          Mid
                        </button>
                        <button
                          type="button"
                          class="seg green"
                          data-action="confidence"
                          data-value="green"
                          aria-pressed={topic.confidence === "green"}
                        >
                          Done
                        </button>
                      </div>
                    </li>
                  ))}
                </ul>
              </details>
            );
          })
        }
        <p id="empty" class="empty" hidden={state.categories.length > 0}>
          Save curriculum.txt to generate topic cards.
        </p>
      </div>
    </section>
  </div>

  <script id="boot" type="application/json" is:inline set:html={boot} />

  <script is:inline>
    (function () {
      var bootEl = document.getElementById("boot");
      var listEl = document.getElementById("list");
      var emptyEl = document.getElementById("empty");
      var statusEl = document.getElementById("save-status");
      var loadErrorEl = document.getElementById("load-error");
      var sourceEl = document.getElementById("source");
      var gutterEl = document.getElementById("gutter");
      var metaEl = document.getElementById("file-meta");
      var copyEl = document.getElementById("copy-curriculum");
      var saveEl = document.getElementById("save-curriculum");
      var topicsMetaEl = document.getElementById("topics-meta");
      var ankiSourceEl = document.getElementById("anki-source");
      var ankiGutterEl = document.getElementById("anki-gutter");
      var ankiMetaEl = document.getElementById("anki-meta");
      var ankiStatusEl = document.getElementById("anki-status");
      var copyAnkiEl = document.getElementById("copy-anki");
      var saveAnkiEl = document.getElementById("save-anki");
      var uploadAnkiEl = document.getElementById("upload-anki");
      var ankiUploadEl = document.getElementById("anki-upload");
      var displayStatusEl = document.getElementById("display-status");
      var displayMetaEl = document.getElementById("display-meta");
      var ankiVisibleEl = document.getElementById("anki-visible");
      var ankiHeightEl = document.getElementById("anki-height");
      var ankiHeightValEl = document.getElementById("anki-height-val");
      var ankiTimerStageEl = document.getElementById("anki-timer-stage");
      var ankiTimerClockEl = document.getElementById("anki-timer-clock");
      var ankiTimerSubEl = document.getElementById("anki-timer-sub");
      var ankiShowAnswerEl = document.getElementById("anki-show-answer");
      var ankiNextStageEl = document.getElementById("anki-next-stage");
      var ankiNextCardEl = document.getElementById("anki-next-card");
      var topicColumnsEl = document.getElementById("topic-columns");
      if (!bootEl || !listEl || !emptyEl || !statusEl || !sourceEl || !gutterEl || !metaEl || !saveEl || !ankiSourceEl || !ankiGutterEl || !saveAnkiEl) return;

      var boot = JSON.parse(bootEl.textContent || "{}");
      var state = boot.state || { title: "Curriculum", theme: "dark", source: "", categories: [] };
      var FRONT_MS = (boot.anki && boot.anki.frontMs) || 30000;
      var CARD_MS = (boot.anki && boot.anki.cardMs) || 120000;
      var inFlight = false;
      var queued = false;
      var queuedSource = false;
      var queuedAnki = false;
      var queuedDisplay = null;
      var clearTimer = 0;
      var heightTimer = 0;

      function setStatus(text, kind, targets) {
        var els = targets || [statusEl, ankiStatusEl];
        for (var s = 0; s < els.length; s++) {
          if (!els[s]) continue;
          els[s].textContent = text;
          els[s].dataset.kind = kind || "";
        }
        window.clearTimeout(clearTimer);
        if (kind === "ok") {
          clearTimer = window.setTimeout(function () {
            for (var i = 0; i < els.length; i++) {
              if (els[i] && els[i].dataset.kind === "ok") {
                els[i].textContent = "";
                els[i].dataset.kind = "";
              }
            }
          }, 1600);
        }
      }

      function clock(ms) {
        var s = Math.max(0, Math.ceil(ms / 1000));
        var m = Math.floor(s / 60);
        s = s % 60;
        return m + ":" + (s < 10 ? "0" : "") + s;
      }

      function ankiPos() {
        var cards = Array.isArray(state.ankiCards) ? state.ankiCards : [];
        if (!cards.length) return null;
        var origin = typeof state.ankiCycleAt === "number" ? state.ankiCycleAt : Date.now();
        var elapsed = Math.max(0, Date.now() - origin);
        var index = Math.floor(elapsed / CARD_MS) % cards.length;
        var inCard = elapsed % CARD_MS;
        var showBack = inCard >= FRONT_MS;
        return {
          count: cards.length,
          index: index,
          showBack: showBack,
          stageRemain: (showBack ? CARD_MS : FRONT_MS) - inCard,
          cardRemain: CARD_MS - inCard,
        };
      }

      function paintTimer() {
        var pos = ankiPos();
        var disabled = !pos;
        if (ankiShowAnswerEl) ankiShowAnswerEl.disabled = disabled || !!(pos && pos.showBack);
        if (ankiNextStageEl) ankiNextStageEl.disabled = disabled;
        if (ankiNextCardEl) ankiNextCardEl.disabled = disabled;
        if (ankiVisibleEl) ankiVisibleEl.disabled = false;
        if (!pos) {
          if (ankiTimerStageEl) ankiTimerStageEl.textContent = "No cards";
          if (ankiTimerClockEl) ankiTimerClockEl.textContent = "—";
          if (ankiTimerSubEl) ankiTimerSubEl.textContent = "Upload or paste anki.txt to start the cycle";
          if (displayMetaEl) displayMetaEl.textContent = "Kiosk Anki";
          return;
        }
        if (ankiTimerStageEl) {
          ankiTimerStageEl.textContent =
            (state.ankiHidden ? "Hidden · " : "") + (pos.showBack ? "Back" : "Front") + " · " + (pos.index + 1) + "/" + pos.count;
        }
        if (ankiTimerClockEl) ankiTimerClockEl.textContent = clock(pos.stageRemain);
        if (ankiTimerSubEl) {
          ankiTimerSubEl.textContent = pos.showBack
            ? "Next card in " + clock(pos.cardRemain)
            : "Answer in " + clock(pos.stageRemain) + " · next card in " + clock(pos.cardRemain);
        }
        if (displayMetaEl) displayMetaEl.textContent = pos.index + 1 + "/" + pos.count;
      }

      function applyDisplay(data) {
        if (typeof data.ankiHidden === "boolean") state.ankiHidden = data.ankiHidden;
        if (typeof data.ankiHeightVh === "number") state.ankiHeightVh = data.ankiHeightVh;
        if (typeof data.ankiCycleAt === "number") state.ankiCycleAt = data.ankiCycleAt;
        if (typeof data.topicColumns === "number") state.topicColumns = data.topicColumns;
        if (typeof data.updatedAt === "number") state.updatedAt = data.updatedAt;
        if (ankiVisibleEl) {
          ankiVisibleEl.setAttribute("aria-pressed", state.ankiHidden ? "false" : "true");
          ankiVisibleEl.textContent = state.ankiHidden ? "Hidden" : "Shown";
        }
        if (ankiHeightEl && String(ankiHeightEl.value) !== String(state.ankiHeightVh)) {
          ankiHeightEl.value = String(state.ankiHeightVh);
        }
        if (ankiHeightValEl) ankiHeightValEl.textContent = state.ankiHeightVh + "vh";
        if (topicColumnsEl) {
          var colBtns = topicColumnsEl.querySelectorAll("[data-columns]");
          for (var c = 0; c < colBtns.length; c++) {
            colBtns[c].setAttribute(
              "aria-pressed",
              String(Number(colBtns[c].getAttribute("data-columns")) === Number(state.topicColumns)),
            );
          }
        }
        paintTimer();
      }

      function syncGutter() {
        fillGutter(sourceEl, gutterEl, metaEl, "lines");
      }

      function syncAnkiGutter() {
        fillGutter(ankiSourceEl, ankiGutterEl, null, "lines");
      }

      function fillGutter(input, gutter, meta, unit) {
        var count = input.value.split("\n").length;
        var lines = "";
        for (var i = 1; i <= count; i++) lines += i + (i === count ? "" : "\n");
        gutter.textContent = lines;
        if (meta && unit === "lines") meta.textContent = count + " lines";
      }

      function findCategory(id) {
        for (var i = 0; i < state.categories.length; i++) {
          if (state.categories[i].id === id) return state.categories[i];
        }
        return null;
      }

      function findTopic(category, id) {
        for (var i = 0; i < category.topics.length; i++) {
          if (category.topics[i].id === id) return category.topics[i];
        }
        return null;
      }

      function progressLabel(category) {
        var total = category.topics.length;
        var done = 0;
        for (var i = 0; i < total; i++) {
          if (category.topics[i].confidence === "green") done++;
        }
        var pct = total === 0 ? 0 : Math.round((done * 100) / total);
        return done + "/" + total + " (" + pct + "%)";
      }

      function openIds() {
        var ids = [];
        var open = listEl.querySelectorAll("details[open]");
        for (var i = 0; i < open.length; i++) ids.push(open[i].getAttribute("data-id"));
        return ids;
      }

      function escapeHtml(value) {
        return String(value)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      function renderList() {
        var opened = openIds();
        var html = "";
        for (var c = 0; c < state.categories.length; c++) {
          var category = state.categories[c];
          html += '<details class="category" data-id="' + escapeHtml(category.id) + '"' + (opened.indexOf(category.id) !== -1 ? " open" : "") + ">";
          html += "<summary>";
          html += '<span class="summary-name"></span>';
          html += '<span class="summary-progress">' + escapeHtml(progressLabel(category)) + "</span>";
          html += '<button type="button" class="btn collapse" data-action="collapse" aria-pressed="' + (category.collapsed ? "true" : "false") + '">';
          html += category.collapsed ? "Collapsed" : "Shown";
          html += "</button></summary><ul class='topics'>";
          for (var t = 0; t < category.topics.length; t++) {
            var topic = category.topics[t];
            html += '<li class="topic" data-id="' + escapeHtml(topic.id) + '" data-confidence="' + topic.confidence + '">';
            html += '<span class="topic-name"></span>';
            html += '<div class="segment" role="group">';
            html += '<button type="button" class="seg red" data-action="confidence" data-value="red">Need</button>';
            html += '<button type="button" class="seg yellow" data-action="confidence" data-value="yellow">Mid</button>';
            html += '<button type="button" class="seg green" data-action="confidence" data-value="green">Done</button>';
            html += "</div></li>";
          }
          html += "</ul></details>";
        }
        if (!state.categories.length) {
          html = '<p id="empty" class="empty">Save curriculum.txt to generate topic cards.</p>';
        }
        listEl.innerHTML = html;
        emptyEl = document.getElementById("empty");
        if (topicsMetaEl) {
          var n = state.categories.length;
          topicsMetaEl.textContent = n + (n === 1 ? " category" : " categories");
        }

        var cats = listEl.querySelectorAll(".category");
        for (var i = 0; i < cats.length; i++) {
          var catNode = cats[i];
          var cat = findCategory(catNode.getAttribute("data-id"));
          catNode.querySelector(".summary-name").textContent = cat.name;
          var rows = catNode.querySelectorAll(".topic");
          for (var r = 0; r < rows.length; r++) {
            var item = cat.topics[r];
            rows[r].querySelector(".topic-name").textContent = item.name;
            var buttons = rows[r].querySelectorAll("[data-action='confidence']");
            for (var b = 0; b < buttons.length; b++) {
              buttons[b].setAttribute("aria-pressed", buttons[b].getAttribute("data-value") === item.confidence ? "true" : "false");
            }
          }
        }
      }

      async function save(includeSource, includeAnki, displayPatch) {
        if (inFlight) {
          queued = true;
          if (includeSource) queuedSource = true;
          if (includeAnki) queuedAnki = true;
          if (displayPatch) queuedDisplay = Object.assign({}, queuedDisplay || {}, displayPatch);
          return;
        }
        inFlight = true;
        var displayOnly = !!(displayPatch && !includeSource && !includeAnki);
        var statusTargets = displayOnly && displayStatusEl ? [displayStatusEl] : [statusEl, ankiStatusEl];
        if (displayPatch) queuedDisplay = Object.assign({}, queuedDisplay || {}, displayPatch);
        setStatus("Saving…", "pending", statusTargets);
        try {
          do {
            var sendSource = queuedSource || includeSource;
            var sendAnki = queuedAnki || includeAnki;
            var sendDisplay = queuedDisplay;
            queued = false;
            queuedSource = false;
            queuedAnki = false;
            queuedDisplay = null;
            includeSource = false;
            includeAnki = false;
            displayOnly = !sendSource && !sendAnki && !!sendDisplay;
            statusTargets = displayOnly && displayStatusEl ? [displayStatusEl] : [statusEl, ankiStatusEl];
            var body = {
              title: state.title || "MSRA Master Clinical Curriculum",
              theme: "dark",
              categories: state.categories,
            };
            if (sendSource) body.source = sourceEl.value;
            if (sendAnki) body.ankiSource = ankiSourceEl.value;
            if (sendDisplay) {
              if (typeof sendDisplay.ankiHidden === "boolean") body.ankiHidden = sendDisplay.ankiHidden;
              if (typeof sendDisplay.ankiHeightVh === "number") body.ankiHeightVh = sendDisplay.ankiHeightVh;
              if (typeof sendDisplay.ankiCycleAt === "number") body.ankiCycleAt = sendDisplay.ankiCycleAt;
              if (typeof sendDisplay.topicColumns === "number") body.topicColumns = sendDisplay.topicColumns;
            }
            var res = await fetch("/api/topics", {
              method: "PUT",
              headers: { "Content-Type": "application/json", Accept: "application/json" },
              body: JSON.stringify(body),
            });
            var data = await res.json().catch(function () {
              return {};
            });
            if (!res.ok) throw new Error(data.error || "Save failed");
            if (sendSource && data.categories) {
              state = data;
              if (typeof data.source === "string") sourceEl.value = data.source;
              if (typeof data.ankiSource === "string") ankiSourceEl.value = data.ankiSource;
              syncGutter();
              syncAnkiGutter();
              renderList();
            } else if (sendAnki) {
              state.ankiSource = data.ankiSource || ankiSourceEl.value;
              state.ankiCards = data.ankiCards || [];
              state.updatedAt = data.updatedAt || Date.now();
              if (ankiMetaEl) ankiMetaEl.textContent = state.ankiCards.length + " cards";
            } else {
              state.updatedAt = data.updatedAt || Date.now();
            }
            applyDisplay(data);
            if (loadErrorEl) loadErrorEl.hidden = true;
          } while (queued);
          setStatus("Saved", "ok", statusTargets);
        } catch (err) {
          setStatus(err && err.message ? err.message : "Couldn’t save. Tap to retry.", "error", statusTargets);
        } finally {
          inFlight = false;
        }
      }

      syncGutter();
      syncAnkiGutter();
      applyDisplay(state);
      paintTimer();
      setInterval(paintTimer, 250);
      sourceEl.addEventListener("input", syncGutter);
      sourceEl.addEventListener("scroll", function () {
        gutterEl.scrollTop = sourceEl.scrollTop;
      });
      ankiSourceEl.addEventListener("input", syncAnkiGutter);
      ankiSourceEl.addEventListener("scroll", function () {
        ankiGutterEl.scrollTop = ankiSourceEl.scrollTop;
      });

      statusEl.addEventListener("click", function () {
        if (statusEl.dataset.kind === "error") save(false, false);
      });
      if (ankiStatusEl) {
        ankiStatusEl.addEventListener("click", function () {
          if (ankiStatusEl.dataset.kind === "error") save(false, true);
        });
      }

      if (copyEl) {
        copyEl.addEventListener("click", function () {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(sourceEl.value).then(
              function () {
                copyEl.textContent = "Copied";
                window.setTimeout(function () {
                  copyEl.textContent = "Copy";
                }, 1200);
              },
              function () {},
            );
          }
        });
      }

      saveEl.addEventListener("click", function () {
        save(true, false);
      });
      saveAnkiEl.addEventListener("click", function () {
        save(false, true);
      });
      function applyAnkiText(text) {
        var max = Number(ankiUploadEl && ankiUploadEl.getAttribute("data-max")) || 500000;
        var next = String(text || "").replace(/^\uFEFF/, "").replace(/\r\n/g, "\n");
        if (next.length > max) {
          setStatus("anki.txt is too long", "error");
          return;
        }
        ankiSourceEl.value = next;
        syncAnkiGutter();
        save(false, true);
      }
      if (uploadAnkiEl && ankiUploadEl) {
        uploadAnkiEl.addEventListener("click", function () {
          ankiUploadEl.click();
        });
        ankiUploadEl.addEventListener("change", function () {
          var file = ankiUploadEl.files && ankiUploadEl.files[0];
          ankiUploadEl.value = "";
          if (!file) return;
          if (file.size > 2 * 1024 * 1024) {
            setStatus("anki.txt is too long", "error");
            return;
          }
          var reader = new FileReader();
          reader.onload = function () {
            applyAnkiText(typeof reader.result === "string" ? reader.result : "");
          };
          reader.onerror = function () {
            setStatus("Couldn’t read that file.", "error");
          };
          reader.readAsText(file);
        });
      }
      if (copyAnkiEl) {
        copyAnkiEl.addEventListener("click", function () {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(ankiSourceEl.value).then(
              function () {
                copyAnkiEl.textContent = "Copied";
                window.setTimeout(function () {
                  copyAnkiEl.textContent = "Copy";
                }, 1200);
              },
              function () {},
            );
          }
        });
      }

      if (displayStatusEl) {
        displayStatusEl.addEventListener("click", function () {
          if (displayStatusEl.dataset.kind === "error") {
            save(false, false, {
              ankiHidden: state.ankiHidden === true,
              ankiHeightVh: Number(state.ankiHeightVh),
              ankiCycleAt: state.ankiCycleAt,
              topicColumns: Number(state.topicColumns),
            });
          }
        });
      }

      if (ankiVisibleEl) {
        ankiVisibleEl.addEventListener("click", function () {
          var hidden = ankiVisibleEl.getAttribute("aria-pressed") !== "false";
          applyDisplay({ ankiHidden: hidden });
          save(false, false, { ankiHidden: hidden });
        });
      }

      if (ankiHeightEl) {
        ankiHeightEl.addEventListener("input", function () {
          if (ankiHeightValEl) ankiHeightValEl.textContent = ankiHeightEl.value + "vh";
          window.clearTimeout(heightTimer);
          heightTimer = window.setTimeout(function () {
            save(false, false, { ankiHeightVh: Number(ankiHeightEl.value) });
          }, 250);
        });
        ankiHeightEl.addEventListener("change", function () {
          window.clearTimeout(heightTimer);
          save(false, false, { ankiHeightVh: Number(ankiHeightEl.value) });
        });
      }

      if (topicColumnsEl) {
        topicColumnsEl.addEventListener("click", function (event) {
          var button = event.target.closest("button[data-columns]");
          if (!button) return;
          var n = Number(button.getAttribute("data-columns"));
          applyDisplay({ topicColumns: n });
          save(false, false, { topicColumns: n });
        });
      }

      function jumpCycle(kind) {
        var pos = ankiPos();
        if (!pos) return;
        var now = Date.now();
        var nextAt = now;
        if (kind === "answer") {
          nextAt = now - (pos.index * CARD_MS + FRONT_MS);
        } else if (kind === "stage") {
          if (pos.showBack) nextAt = now - ((pos.index + 1) % pos.count) * CARD_MS;
          else nextAt = now - (pos.index * CARD_MS + FRONT_MS);
        } else {
          nextAt = now - ((pos.index + 1) % pos.count) * CARD_MS;
        }
        save(false, false, { ankiCycleAt: nextAt });
      }

      if (ankiShowAnswerEl) {
        ankiShowAnswerEl.addEventListener("click", function () {
          jumpCycle("answer");
        });
      }
      if (ankiNextStageEl) {
        ankiNextStageEl.addEventListener("click", function () {
          jumpCycle("stage");
        });
      }
      if (ankiNextCardEl) {
        ankiNextCardEl.addEventListener("click", function () {
          jumpCycle("card");
        });
      }

      listEl.addEventListener("click", function (event) {
        var button = event.target.closest("button");
        if (!button) return;
        var action = button.getAttribute("data-action");
        var catNode = button.closest(".category");
        if (!catNode) return;
        var category = findCategory(catNode.getAttribute("data-id"));
        if (!category) return;

        if (action === "collapse") {
          event.preventDefault();
          event.stopPropagation();
          category.collapsed = !category.collapsed;
          button.setAttribute("aria-pressed", category.collapsed ? "true" : "false");
          button.textContent = category.collapsed ? "Collapsed" : "Shown";
          save(false, false);
          return;
        }

        if (action === "confidence") {
          var row = button.closest(".topic");
          var topic = findTopic(category, row.getAttribute("data-id"));
          topic.confidence = button.getAttribute("data-value");
          var buttons = row.querySelectorAll("[data-action='confidence']");
          for (var i = 0; i < buttons.length; i++) {
            buttons[i].setAttribute("aria-pressed", buttons[i].getAttribute("data-value") === topic.confidence ? "true" : "false");
          }
          row.setAttribute("data-confidence", topic.confidence);
          catNode.querySelector(".summary-progress").textContent = progressLabel(category);
          save(false, false);
        }
      });
    })();
  </script>
</Layout>
