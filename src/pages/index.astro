---
import Layout from "../layouts/Layout.astro";
import { ANKI_CARD_MS, ANKI_FRONT_MS, ANKI_HEIGHT_DEFAULT } from "../lib/anki-cycle";
import { TOPIC_COLUMNS_DEFAULT } from "../lib/display";
import { DEFAULT_TITLE } from "../lib/defaults";
import { getState } from "../lib/store";
import { categoryProgress } from "../lib/progress";
import { DATA_VERSION, STATUS_LABEL, type AppState } from "../lib/types";

let loaded = true;
let state: AppState;

try {
  state = await getState();
} catch {
  loaded = false;
  state = {
    version: DATA_VERSION,
    title: DEFAULT_TITLE,
    theme: "dark",
    source: "",
    ankiSource: "",
    ankiCards: [],
    ankiHidden: false,
    ankiHeightVh: ANKI_HEIGHT_DEFAULT,
    ankiCycleAt: 0,
    topicColumns: TOPIC_COLUMNS_DEFAULT,
    categories: [],
    updatedAt: 0,
  };
}

const boot = JSON.stringify({
  loaded,
  state,
  anki: { frontMs: ANKI_FRONT_MS, cardMs: ANKI_CARD_MS },
}).replace(/</g, "\\u003c");
---

<Layout title="Curriculum" page="display">
  <div class="frame" data-anki={state.ankiCards.length && !state.ankiHidden ? "on" : "off"}>
    <div class="stage">
      <p id="empty" class="empty" hidden={state.categories.length > 0 || !loaded}>
        No topics yet
      </p>
      <p id="waiting" class="empty" hidden={loaded}>
        Waiting for topics…
      </p>

      <div id="board" class="board" data-columns={state.topicColumns}>
        {
          state.categories.map((category) => (
            <article class="cat" data-collapsed={category.collapsed ? "true" : "false"}>
              <h2>
                <span class="cat-title">{category.name}</span>
                <span class="cat-progress">{categoryProgress(category).label}</span>
              </h2>
              {category.collapsed ? null : (
                <ul>
                  {category.topics.map((topic) => (
                    <li>
                      <span class="topic-name">{topic.name}</span>
                      <span class="tag" data-confidence={topic.confidence}>
                        {STATUS_LABEL[topic.confidence]}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))
        }
      </div>
    </div>

    <section
      id="anki"
      class="anki"
      hidden={!state.ankiCards.length || state.ankiHidden}
      style={`--anki-dock: ${state.ankiHeightVh}vh`}
    >
      <div class="anki-head">
        <span class="anki-title">Anki</span>
        <span id="anki-side" class="anki-side">{state.ankiCards.length ? "Front" : ""}</span>
        <span id="anki-count" class="anki-count">
          {state.ankiCards.length ? `1/${state.ankiCards.length}` : ""}
        </span>
      </div>
      <div id="anki-text" class="anki-text" set:html={state.ankiCards[0] ? state.ankiCards[0].front : ""} />
    </section>
  </div>

  <script id="boot" type="application/json" is:inline set:html={boot} />

  <script is:inline>
    (function () {
      var POLL_MS = 2000;
      var CACHE_KEY = "study-dashboard-cache";
      var labels = {
        red: "Needs study",
        yellow: "Improving",
        green: "Confident",
      };

      var boardEl = document.getElementById("board");
      var emptyEl = document.getElementById("empty");
      var waitingEl = document.getElementById("waiting");
      var bootEl = document.getElementById("boot");
      var frameEl = document.querySelector(".frame");
      var ankiEl = document.getElementById("anki");
      var ankiText = document.getElementById("anki-text");
      var ankiSide = document.getElementById("anki-side");
      var ankiCount = document.getElementById("anki-count");
      if (!boardEl || !emptyEl || !waitingEl || !bootEl) return;

      var boot = JSON.parse(bootEl.textContent || "{}");
      var state = boot.state || { categories: [], ankiCards: [], updatedAt: 0 };
      var FRONT_MS = (boot.anki && boot.anki.frontMs) || 30000;
      var CARD_MS = (boot.anki && boot.anki.cardMs) || 120000;
      var ankiKey = "";
      var pollTimer = 0;
      var pollBusy = false;

      function isArray(value) {
        return Object.prototype.toString.call(value) === "[object Array]";
      }

      function nowMs() {
        return new Date().getTime();
      }

      function setHidden(el, hide) {
        if (!el) return;
        if (hide) el.setAttribute("hidden", "hidden");
        else el.removeAttribute("hidden");
      }

      function clearNode(el) {
        while (el.firstChild) el.removeChild(el.firstChild);
      }

      function persist() {
        try {
          localStorage.setItem(CACHE_KEY, JSON.stringify(state));
        } catch (err) {}
      }

      function paint() {
        setHidden(waitingEl, true);

        if (!state.categories.length) {
          clearNode(boardEl);
          setHidden(emptyEl, false);
          applyColumns();
          return;
        }

        setHidden(emptyEl, true);
        var frag = document.createDocumentFragment();
        for (var c = 0; c < state.categories.length; c++) {
          var category = state.categories[c];
          var article = document.createElement("article");
          article.className = "cat";
          article.setAttribute("data-collapsed", category.collapsed ? "true" : "false");
          var heading = document.createElement("h2");
          var title = document.createElement("span");
          title.className = "cat-title";
          title.textContent = category.name;
          var progress = document.createElement("span");
          progress.className = "cat-progress";
          progress.textContent = progressLabel(category);
          heading.appendChild(title);
          heading.appendChild(progress);
          article.appendChild(heading);
          if (!category.collapsed) {
            var list = document.createElement("ul");
            for (var t = 0; t < category.topics.length; t++) {
              var topic = category.topics[t];
              var li = document.createElement("li");
              var name = document.createElement("span");
              name.className = "topic-name";
              name.textContent = topic.name;
              var tag = document.createElement("span");
              tag.className = "tag";
              tag.setAttribute("data-confidence", topic.confidence);
              tag.textContent = labels[topic.confidence] || topic.confidence;
              li.appendChild(name);
              li.appendChild(tag);
              list.appendChild(li);
            }
            article.appendChild(list);
          }
          frag.appendChild(article);
        }
        clearNode(boardEl);
        boardEl.appendChild(frag);
        applyColumns();
      }

      function ankiCards() {
        return isArray(state.ankiCards) ? state.ankiCards : [];
      }

      function ankiPos() {
        var cards = ankiCards();
        if (!cards.length) return null;
        var origin = typeof state.ankiCycleAt === "number" ? state.ankiCycleAt : nowMs();
        var elapsed = Math.max(0, nowMs() - origin);
        var index = Math.floor(elapsed / CARD_MS) % cards.length;
        var inCard = elapsed % CARD_MS;
        return {
          index: index,
          showBack: inCard >= FRONT_MS,
          cards: cards,
        };
      }

      function paintAnki() {
        if (!ankiEl || !ankiText || !ankiSide) return;
        var pos = ankiPos();
        var show = !!(pos && !state.ankiHidden);
        setHidden(ankiEl, !show);
        if (frameEl) frameEl.setAttribute("data-anki", show ? "on" : "off");
        var height = Number(state.ankiHeightVh);
        if (height === height && height > 0) {
          var dock = height + "vh";
          try {
            ankiEl.style.setProperty("--anki-dock", dock);
          } catch (err) {}
          ankiEl.style.height = dock;
          ankiEl.style.flexBasis = dock;
        }
        if (!pos) return;
        var card = pos.cards[pos.index];
        ankiSide.textContent = pos.showBack ? "Back" : "Front";
        if (ankiCount) ankiCount.textContent = pos.index + 1 + "/" + pos.cards.length;
        ankiText.innerHTML = pos.showBack ? card.back : card.front;
      }

      function syncAnkiDeck() {
        var key = JSON.stringify(ankiCards());
        if (key !== ankiKey) ankiKey = key;
        paintAnki();
      }

      function progressLabel(category) {
        var total = category.topics.length;
        var done = 0;
        for (var i = 0; i < total; i++) {
          if (category.topics[i].confidence === "green") done++;
        }
        var pct = total === 0 ? 0 : Math.round((done * 100) / total);
        return done + "/" + total + " (" + pct + "%)";
      }

      function applyColumns() {
        var n = Number(state.topicColumns);
        if (!(n >= 1 && n <= 4)) n = 2;
        n = Math.round(n);
        boardEl.setAttribute("data-columns", String(n));
        boardEl.style.display = "flex";
        boardEl.style.webkitBoxAlign = "start";
        boardEl.style.webkitAlignItems = "flex-start";
        boardEl.style.alignItems = "flex-start";
        boardEl.style.webkitFlexWrap = "wrap";
        boardEl.style.flexWrap = "wrap";
        boardEl.style.webkitAlignContent = "flex-start";
        boardEl.style.alignContent = "flex-start";
        boardEl.style.columnCount = "auto";
        boardEl.style.webkitColumnCount = "auto";
        boardEl.style.gridTemplateColumns = "";
        boardEl.style.gap = "";
        var w = "calc(" + (100 / n).toFixed(4) + "% - 16px)";
        var cats = boardEl.children;
        for (var i = 0; i < cats.length; i++) {
          if (cats[i].nodeType !== 1) continue;
          cats[i].style.cssFloat = "none";
          cats[i].style.webkitBoxFlex = "0";
          cats[i].style.webkitFlex = "0 0 auto";
          cats[i].style.flex = "0 0 auto";
          cats[i].style.webkitAlignSelf = "flex-start";
          cats[i].style.alignSelf = "flex-start";
          cats[i].style.width = w;
          cats[i].style.maxWidth = w;
          cats[i].style.minWidth = "0";
          cats[i].style.height = "auto";
          cats[i].style.boxSizing = "border-box";
          cats[i].style.marginLeft = "8px";
          cats[i].style.marginRight = "8px";
        }
      }

      function applyPayload(next) {
        if (!next || !isArray(next.categories)) return;
        var prev = JSON.stringify(state.categories);
        var incoming = JSON.stringify(next.categories);
        state = next;
        persist();
        if (prev !== incoming) paint();
        else applyColumns();
        syncAnkiDeck();
      }

      function poll() {
        if (pollBusy) return;
        pollBusy = true;
        var url = "/api/topics?t=" + nowMs() + "&n=" + Math.random();
        var xhr = new XMLHttpRequest();
        var finished = false;
        var abortTimer = setTimeout(function () {
          if (finished) return;
          try {
            xhr.abort();
          } catch (err) {}
        }, 8000);

        function done() {
          if (finished) return;
          finished = true;
          pollBusy = false;
          clearTimeout(abortTimer);
          clearTimeout(pollTimer);
          pollTimer = setTimeout(poll, POLL_MS);
        }

        xhr.onreadystatechange = function () {
          if (xhr.readyState !== 4) return;
          try {
            if (xhr.status >= 200 && xhr.status < 300 && xhr.responseText) {
              applyPayload(JSON.parse(xhr.responseText));
            }
          } catch (err) {}
          done();
        };

        xhr.onerror = done;
        xhr.onabort = done;

        try {
          xhr.open("GET", url, true);
          xhr.setRequestHeader("Accept", "application/json");
          xhr.setRequestHeader("Cache-Control", "no-cache");
          xhr.setRequestHeader("Pragma", "no-cache");
          xhr.send(null);
        } catch (err) {
          done();
        }
      }

      if (!boot.loaded) {
        try {
          var cached = localStorage.getItem(CACHE_KEY);
          if (cached) {
            var parsed = JSON.parse(cached);
            if (parsed && isArray(parsed.categories) && parsed.categories.length) {
              state = parsed;
              paint();
            }
          }
        } catch (err) {}
      } else {
        persist();
      }

      function keepAwake() {
        try {
          if (navigator.wakeLock && navigator.wakeLock.request) {
            navigator.wakeLock.request("screen");
          }
        } catch (err) {}
      }

      keepAwake();
      applyColumns();
      syncAnkiDeck();
      setInterval(paintAnki, 250);
      poll();
      document.addEventListener("visibilitychange", function () {
        if (document.visibilityState === "visible") {
          keepAwake();
          poll();
        }
      });
    })();
  </script>
</Layout>
