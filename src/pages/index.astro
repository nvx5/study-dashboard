---
import Layout from "../layouts/Layout.astro";
import { ANKI_CARD_MS, ANKI_FRONT_MS, ANKI_HEIGHT_DEFAULT } from "../lib/anki-cycle";
import { DEFAULT_TITLE } from "../lib/defaults";
import { getState } from "../lib/store";
import { categoryProgress } from "../lib/progress";
import { DATA_VERSION, STATUS_LABEL, type AppState } from "../lib/types";

let loaded = true;
let state: AppState;

try {
  state = await getState();
} catch {
  loaded = false;
  state = {
    version: DATA_VERSION,
    title: DEFAULT_TITLE,
    theme: "dark",
    source: "",
    ankiSource: "",
    ankiCards: [],
    ankiHidden: false,
    ankiHeightVh: ANKI_HEIGHT_DEFAULT,
    ankiCycleAt: 0,
    categories: [],
    updatedAt: 0,
  };
}

const boot = JSON.stringify({
  loaded,
  state,
  anki: { frontMs: ANKI_FRONT_MS, cardMs: ANKI_CARD_MS },
}).replace(/</g, "\\u003c");
---

<Layout title="Curriculum" page="display">
  <div class="frame" data-anki={state.ankiCards.length && !state.ankiHidden ? "on" : "off"}>
    <div class="stage">
      <p id="empty" class="empty" hidden={state.categories.length > 0 || !loaded}>
        No topics yet
      </p>
      <p id="waiting" class="empty" hidden={loaded}>
        Waiting for topics…
      </p>

      <div id="board" class="board">
        {
          state.categories.map((category) => (
            <article class="cat" data-collapsed={category.collapsed ? "true" : "false"}>
              <h2>
                <span class="cat-title">{category.name}</span>
                <span class="cat-progress">{categoryProgress(category).label}</span>
              </h2>
              {category.collapsed ? null : (
                <ul>
                  {category.topics.map((topic) => (
                    <li>
                      <span class="topic-name">{topic.name}</span>
                      <span class="tag" data-confidence={topic.confidence}>
                        {STATUS_LABEL[topic.confidence]}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))
        }
      </div>
    </div>

    <section
      id="anki"
      class="anki"
      hidden={!state.ankiCards.length || state.ankiHidden}
      style={`--anki-dock: ${state.ankiHeightVh}vh`}
    >
      <div class="anki-head">
        <span class="anki-title">Anki</span>
        <span id="anki-side" class="anki-side">{state.ankiCards.length ? "Front" : ""}</span>
        <span id="anki-count" class="anki-count">
          {state.ankiCards.length ? `1/${state.ankiCards.length}` : ""}
        </span>
      </div>
      <div id="anki-text" class="anki-text" set:html={state.ankiCards[0] ? state.ankiCards[0].front : ""} />
    </section>
  </div>

  <script id="boot" type="application/json" is:inline set:html={boot} />

  <script is:inline>
    (function () {
      var POLL_MS = 2000;
      var CACHE_KEY = "study-dashboard-cache";
      var labels = {
        red: "Needs study",
        yellow: "Improving",
        green: "Confident",
      };

      var boardEl = document.getElementById("board");
      var emptyEl = document.getElementById("empty");
      var waitingEl = document.getElementById("waiting");
      var bootEl = document.getElementById("boot");
      var frameEl = document.querySelector(".frame");
      var ankiEl = document.getElementById("anki");
      var ankiText = document.getElementById("anki-text");
      var ankiSide = document.getElementById("anki-side");
      var ankiCount = document.getElementById("anki-count");
      if (!boardEl || !emptyEl || !waitingEl || !bootEl) return;

      var boot = JSON.parse(bootEl.textContent || "{}");
      var state = boot.state || { categories: [], ankiCards: [], updatedAt: 0 };
      var FRONT_MS = (boot.anki && boot.anki.frontMs) || 30000;
      var CARD_MS = (boot.anki && boot.anki.cardMs) || 120000;
      var ankiKey = "";

      function persist() {
        try {
          localStorage.setItem(CACHE_KEY, JSON.stringify(state));
        } catch (err) {}
      }

      function paint() {
        waitingEl.hidden = true;

        if (!state.categories.length) {
          boardEl.replaceChildren();
          emptyEl.hidden = false;
          return;
        }

        emptyEl.hidden = true;
        var frag = document.createDocumentFragment();
        for (var c = 0; c < state.categories.length; c++) {
          var category = state.categories[c];
          var article = document.createElement("article");
          article.className = "cat";
          article.setAttribute("data-collapsed", category.collapsed ? "true" : "false");
          var heading = document.createElement("h2");
          var title = document.createElement("span");
          title.className = "cat-title";
          title.textContent = category.name;
          var progress = document.createElement("span");
          progress.className = "cat-progress";
          progress.textContent = progressLabel(category);
          heading.append(title, progress);
          article.append(heading);
          if (!category.collapsed) {
            var list = document.createElement("ul");
            for (var t = 0; t < category.topics.length; t++) {
              var topic = category.topics[t];
              var li = document.createElement("li");
              var name = document.createElement("span");
              name.className = "topic-name";
              name.textContent = topic.name;
              var tag = document.createElement("span");
              tag.className = "tag";
              tag.setAttribute("data-confidence", topic.confidence);
              tag.textContent = labels[topic.confidence] || topic.confidence;
              li.append(name, tag);
              list.append(li);
            }
            article.append(list);
          }
          frag.append(article);
        }
        boardEl.replaceChildren(frag);
      }

      function ankiCards() {
        return Array.isArray(state.ankiCards) ? state.ankiCards : [];
      }

      function ankiPos() {
        var cards = ankiCards();
        if (!cards.length) return null;
        var origin = typeof state.ankiCycleAt === "number" ? state.ankiCycleAt : Date.now();
        var elapsed = Math.max(0, Date.now() - origin);
        var index = Math.floor(elapsed / CARD_MS) % cards.length;
        var inCard = elapsed % CARD_MS;
        return {
          index: index,
          showBack: inCard >= FRONT_MS,
          cards: cards,
        };
      }

      function paintAnki() {
        if (!ankiEl || !ankiText || !ankiSide) return;
        var pos = ankiPos();
        var show = pos && !state.ankiHidden;
        ankiEl.hidden = !show;
        if (frameEl) frameEl.setAttribute("data-anki", show ? "on" : "off");
        var height = Number(state.ankiHeightVh);
        if (Number.isFinite(height) && height > 0) {
          ankiEl.style.setProperty("--anki-dock", height + "vh");
        }
        if (!pos) return;
        var card = pos.cards[pos.index];
        ankiSide.textContent = pos.showBack ? "Back" : "Front";
        if (ankiCount) ankiCount.textContent = pos.index + 1 + "/" + pos.cards.length;
        ankiText.innerHTML = pos.showBack ? card.back : card.front;
      }

      function syncAnkiDeck() {
        var key = JSON.stringify(ankiCards());
        if (key !== ankiKey) ankiKey = key;
        paintAnki();
      }

      function progressLabel(category) {
        var total = category.topics.length;
        var done = 0;
        for (var i = 0; i < total; i++) {
          if (category.topics[i].confidence === "green") done++;
        }
        var pct = total === 0 ? 0 : Math.round((done * 100) / total);
        return done + "/" + total + " (" + pct + "%)";
      }

      if (!boot.loaded) {
        try {
          var cached = localStorage.getItem(CACHE_KEY);
          if (cached) {
            var parsed = JSON.parse(cached);
            if (parsed && Array.isArray(parsed.categories) && parsed.categories.length) {
              state = parsed;
              paint();
            }
          }
        } catch (err) {}
      } else {
        persist();
      }

      async function poll() {
        var controller = typeof AbortController === "function" ? new AbortController() : null;
        var abortTimer = setTimeout(function () {
          if (controller) controller.abort();
        }, 8000);
        try {
          var options = {
            cache: "no-store",
            headers: {
              Accept: "application/json",
              "Cache-Control": "no-cache",
              Pragma: "no-cache",
            },
          };
          if (controller) options.signal = controller.signal;
          var res = await fetch("/api/topics?t=" + Date.now(), options);
          if (!res.ok) return;
          var next = await res.json();
          if (!next || !Array.isArray(next.categories)) return;
          var prev = JSON.stringify(state.categories);
          var incoming = JSON.stringify(next.categories);
          state = next;
          persist();
          if (prev !== incoming) paint();
          syncAnkiDeck();
        } catch (err) {
        } finally {
          clearTimeout(abortTimer);
        }
      }

      function loop() {
        poll().then(
          function () {
            setTimeout(loop, POLL_MS);
          },
          function () {
            setTimeout(loop, POLL_MS);
          },
        );
      }

      function keepAwake() {
        try {
          if (navigator.wakeLock && navigator.wakeLock.request) {
            navigator.wakeLock.request("screen").catch(function () {});
          }
        } catch (err) {}
      }

      keepAwake();
      syncAnkiDeck();
      setInterval(paintAnki, 250);
      loop();
      document.addEventListener("visibilitychange", function () {
        if (document.visibilityState === "visible") {
          keepAwake();
          poll();
        }
      });
    })();
  </script>
</Layout>
