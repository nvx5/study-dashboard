---
import Layout from "../layouts/Layout.astro";
import {
  clampTopicColumns,
  DEFAULT_TAG_COLORS,
  DEFAULT_TAG_NAMES,
  normalizeTagNames,
  splitIntoColumns,
  tagCssVars,
  TOPIC_COLUMNS_DEFAULT,
} from "../lib/display";
import { DEFAULT_TITLE } from "../lib/defaults";
import { getState } from "../lib/store";
import { categoryProgress } from "../lib/progress";
import { DATA_VERSION, type AppState } from "../lib/types";

let loaded = true;
let state: AppState;

try {
  state = await getState();
} catch {
  loaded = false;
  state = {
    version: DATA_VERSION,
    title: DEFAULT_TITLE,
    theme: "dark",
    source: "",
    topicColumns: TOPIC_COLUMNS_DEFAULT,
    tagNames: { ...DEFAULT_TAG_NAMES },
    tagColors: { ...DEFAULT_TAG_COLORS },
    categories: [],
    updatedAt: 0,
  };
}

const boot = JSON.stringify({
  loaded,
  state,
}).replace(/</g, "\\u003c");

const tagNames = normalizeTagNames(state.tagNames);
---

<Layout title="Curriculum" page="display">
  <div class="frame" style={tagCssVars(state.tagColors)}>
    <div class="stage">
      <p id="empty" class="empty" hidden={state.categories.length > 0 || !loaded}>
        No topics yet
      </p>
      <p id="waiting" class="empty" hidden={loaded}>
        Waiting for topics…
      </p>

      <div id="board" class="board" data-columns={clampTopicColumns(state.topicColumns)}>
        {
          splitIntoColumns(state.categories, state.topicColumns).map((column) => (
            <div class="board-col">
              {column.map((category) => (
                <article class="cat" data-collapsed={category.collapsed ? "true" : "false"}>
                  <h2>
                    <span class="cat-title">{category.name}</span>
                    <span class="cat-progress">{categoryProgress(category).label}</span>
                  </h2>
                  {category.collapsed ? null : (
                    <ul>
                      {category.topics.map((topic) => (
                        <li>
                          <span class="topic-name">{topic.name}</span>
                          <span class="tag" data-confidence={topic.confidence}>
                            {tagNames[topic.confidence]}
                          </span>
                        </li>
                      ))}
                    </ul>
                  )}
                </article>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <script id="boot" type="application/json" is:inline set:html={boot} />

  <script is:inline>
    (function () {
      var POLL_MS = 2000;
      var CACHE_KEY = "study-dashboard-cache";
      var DEFAULT_COLORS = { red: "#f85149", yellow: "#e3b341", green: "#3fb950" };
      var DEFAULT_NAMES = { red: "Needs study", yellow: "Improving", green: "Confident" };

      var boardEl = document.getElementById("board");
      var emptyEl = document.getElementById("empty");
      var waitingEl = document.getElementById("waiting");
      var bootEl = document.getElementById("boot");
      var frameEl = document.querySelector(".frame");
      if (!boardEl || !emptyEl || !waitingEl || !bootEl) return;

      var boot = JSON.parse(bootEl.textContent || "{}");
      var state = boot.state || { categories: [], updatedAt: 0 };
      var pollTimer = 0;
      var pollBusy = false;

      function isArray(value) {
        return Object.prototype.toString.call(value) === "[object Array]";
      }

      function nowMs() {
        return new Date().getTime();
      }

      function setHidden(el, hide) {
        if (!el) return;
        if (hide) el.setAttribute("hidden", "hidden");
        else el.removeAttribute("hidden");
      }

      function clearNode(el) {
        while (el.firstChild) el.removeChild(el.firstChild);
      }

      function persist() {
        try {
          localStorage.setItem(CACHE_KEY, JSON.stringify(state));
        } catch (err) {}
      }

      function columnCount() {
        var n = Number(state.topicColumns);
        if (!(n >= 1 && n <= 4)) n = 2;
        return Math.round(n);
      }

      function parseHex(value) {
        var s = String(value || "").replace(/^\s+|\s+$/g, "").replace(/^#/, "");
        if (s.length === 3 && /^[0-9a-fA-F]{3}$/.test(s)) {
          s = s.charAt(0) + s.charAt(0) + s.charAt(1) + s.charAt(1) + s.charAt(2) + s.charAt(2);
        }
        if (!/^[0-9a-fA-F]{6}$/.test(s)) return "";
        return "#" + s.toLowerCase();
      }

      function tagSwatch(hex) {
        var parsed = parseHex(hex) || DEFAULT_COLORS.red;
        var r = parseInt(parsed.slice(1, 3), 16);
        var g = parseInt(parsed.slice(3, 5), 16);
        var b = parseInt(parsed.slice(5, 7), 16);
        function lin(c) {
          var x = c / 255;
          return x <= 0.03928 ? x / 12.92 : Math.pow((x + 0.055) / 1.055, 2.4);
        }
        var L = 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
        var text = L > 0.45 ? "#111111" : "#ffffff";
        var t = L > 0.45 ? 0.22 : 0.28;
        var toward = L > 0.45 ? 0 : 255;
        function mix(a) {
          var n = Math.round(a + (toward - a) * t);
          var h = n.toString(16);
          return h.length < 2 ? "0" + h : h;
        }
        return { bg: parsed, text: text, border: "#" + mix(r) + mix(g) + mix(b) };
      }

      function tagLabel(conf) {
        var names = state.tagNames || {};
        if (names[conf]) return names[conf];
        return DEFAULT_NAMES[conf] || conf;
      }

      function applyTagTheme() {
        if (!frameEl) return;
        var colors = state.tagColors || {};
        var keys = ["red", "yellow", "green"];
        for (var i = 0; i < keys.length; i++) {
          var key = keys[i];
          var sw = tagSwatch(colors[key] || DEFAULT_COLORS[key]);
          try {
            frameEl.style.setProperty("--tag-" + key + "-bg", sw.bg);
            frameEl.style.setProperty("--tag-" + key + "-text", sw.text);
            frameEl.style.setProperty("--tag-" + key + "-border", sw.border);
          } catch (err) {}
        }
      }

      function makeCat(category) {
        var article = document.createElement("article");
        article.className = "cat";
        article.setAttribute("data-collapsed", category.collapsed ? "true" : "false");
        var heading = document.createElement("h2");
        var title = document.createElement("span");
        title.className = "cat-title";
        title.textContent = category.name;
        var progress = document.createElement("span");
        progress.className = "cat-progress";
        progress.textContent = progressLabel(category);
        heading.appendChild(title);
        heading.appendChild(progress);
        article.appendChild(heading);
        if (!category.collapsed) {
          var list = document.createElement("ul");
          for (var t = 0; t < category.topics.length; t++) {
            var topic = category.topics[t];
            var li = document.createElement("li");
            var name = document.createElement("span");
            name.className = "topic-name";
            name.textContent = topic.name;
            var tag = document.createElement("span");
            tag.className = "tag";
            tag.setAttribute("data-confidence", topic.confidence || "red");
            tag.textContent = tagLabel(topic.confidence || "red");
            li.appendChild(name);
            li.appendChild(tag);
            list.appendChild(li);
          }
          article.appendChild(list);
        }
        return article;
      }

      function paint() {
        setHidden(waitingEl, true);

        if (!state.categories.length) {
          clearNode(boardEl);
          setHidden(emptyEl, false);
          applyColumns();
          return;
        }

        setHidden(emptyEl, true);
        var n = columnCount();
        var cols = [];
        var i;
        for (i = 0; i < n; i++) {
          var col = document.createElement("div");
          col.className = "board-col";
          cols.push(col);
        }
        for (i = 0; i < state.categories.length; i++) {
          cols[i % n].appendChild(makeCat(state.categories[i]));
        }
        clearNode(boardEl);
        for (i = 0; i < n; i++) boardEl.appendChild(cols[i]);
        applyColumns();
      }

      function progressLabel(category) {
        var total = category.topics.length;
        var done = 0;
        for (var i = 0; i < total; i++) {
          if (category.topics[i].confidence === "green") done++;
        }
        var pct = total === 0 ? 0 : Math.round((done * 100) / total);
        return done + "/" + total + " (" + pct + "%)";
      }

      function applyColumns() {
        var n = columnCount();
        boardEl.setAttribute("data-columns", String(n));
        boardEl.style.display = "flex";
        boardEl.style.flexDirection = "row";
        boardEl.style.webkitFlexWrap = "nowrap";
        boardEl.style.flexWrap = "nowrap";
        boardEl.style.webkitAlignItems = "flex-start";
        boardEl.style.alignItems = "flex-start";
        boardEl.style.columnCount = "auto";
        boardEl.style.webkitColumnCount = "auto";
        boardEl.style.gridTemplateColumns = "";
        var cols = boardEl.children;
        if (state.categories.length && cols.length !== n) {
          paint();
          return;
        }
        for (var i = 0; i < cols.length; i++) {
          if (cols[i].nodeType !== 1) continue;
          cols[i].className = "board-col";
          cols[i].style.webkitBoxFlex = "1";
          cols[i].style.webkitFlex = "1 1 0%";
          cols[i].style.flex = "1 1 0%";
          cols[i].style.width = (100 / n).toFixed(4) + "%";
          cols[i].style.minWidth = "0";
          cols[i].style.marginLeft = "8px";
          cols[i].style.marginRight = "8px";
          var cards = cols[i].children;
          for (var c = 0; c < cards.length; c++) {
            if (cards[c].nodeType !== 1) continue;
            cards[c].style.cssFloat = "none";
            cards[c].style.flex = "none";
            cards[c].style.width = "100%";
            cards[c].style.maxWidth = "100%";
            cards[c].style.height = "auto";
            cards[c].style.marginLeft = "0";
            cards[c].style.marginRight = "0";
            cards[c].style.marginBottom = "16px";
          }
        }
      }

      function applyPayload(next) {
        if (!next || !isArray(next.categories)) return;
        var prev = JSON.stringify(state.categories);
        var prevCols = Number(state.topicColumns);
        var prevNames = JSON.stringify(state.tagNames || {});
        var incoming = JSON.stringify(next.categories);
        state = next;
        persist();
        applyTagTheme();
        if (
          prev !== incoming ||
          prevCols !== Number(state.topicColumns) ||
          prevNames !== JSON.stringify(state.tagNames || {})
        ) {
          paint();
        } else applyColumns();
      }

      function poll() {
        if (pollBusy) return;
        pollBusy = true;
        var url = "/api/topics?t=" + nowMs() + "&n=" + Math.random();
        var xhr = new XMLHttpRequest();
        var finished = false;
        var abortTimer = setTimeout(function () {
          if (finished) return;
          try {
            xhr.abort();
          } catch (err) {}
        }, 8000);

        function done() {
          if (finished) return;
          finished = true;
          pollBusy = false;
          clearTimeout(abortTimer);
          clearTimeout(pollTimer);
          pollTimer = setTimeout(poll, POLL_MS);
        }

        xhr.onreadystatechange = function () {
          if (xhr.readyState !== 4) return;
          try {
            if (xhr.status >= 200 && xhr.status < 300 && xhr.responseText) {
              applyPayload(JSON.parse(xhr.responseText));
            }
          } catch (err) {}
          done();
        };

        xhr.onerror = done;
        xhr.onabort = done;

        try {
          xhr.open("GET", url, true);
          xhr.setRequestHeader("Accept", "application/json");
          xhr.setRequestHeader("Cache-Control", "no-cache");
          xhr.setRequestHeader("Pragma", "no-cache");
          xhr.send(null);
        } catch (err) {
          done();
        }
      }

      if (!boot.loaded) {
        try {
          var cached = localStorage.getItem(CACHE_KEY);
          if (cached) {
            var parsed = JSON.parse(cached);
            if (parsed && isArray(parsed.categories) && parsed.categories.length) {
              state = parsed;
              paint();
              applyTagTheme();
            }
          }
        } catch (err) {}
      } else {
        persist();
      }

      function keepAwake() {
        try {
          if (navigator.wakeLock && navigator.wakeLock.request) {
            navigator.wakeLock.request("screen");
          }
        } catch (err) {}
      }

      keepAwake();
      applyTagTheme();
      applyColumns();
      poll();
      document.addEventListener("visibilitychange", function () {
        if (document.visibilityState === "visible") {
          keepAwake();
          poll();
        }
      });
    })();
  </script>
</Layout>
